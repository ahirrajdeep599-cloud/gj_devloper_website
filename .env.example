# ==============================================================================
# GJ DEVLOPER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and fill in your actual production/development values.
# NEVER commit your real .env.local file to GitHub!
# ==============================================================================

# Application Base URL (Used for metadata, OpenGraph and Webhook callbacks)
NEXT_PUBLIC_APP_URL="https://gjdevloper.com"

# Public Brand WhatsApp Contact Number (International format without '+' sign)
NEXT_PUBLIC_WHATSAPP_PHONE="919876543210"

# Admin Authentication & Session Security
# Generate a secure 32+ character random string for production
ADMIN_JWT_SECRET="replace_with_a_secure_random_64_character_hex_string"
ADMIN_USERNAME="your_admin_username"
ADMIN_DEFAULT_PASSWORD="replace_with_a_strong_password_min_12_chars"

# Optional: Google Search Console Verification Code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Optional: Meta WhatsApp Business Cloud API Integration
# Leave empty to use direct wa.me click-to-chat fallback
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="replace_with_custom_verify_token_for_webhook"
WHATSAPP_APP_SECRET=""
ADMIN_WHATSAPP_PHONE=""

# Security Rate Limiter (Optional Redis or memory config)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Supabase Cloud Database & Storage (Optional)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY=""
